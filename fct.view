-library_file { /home/vedic_lab/sclpdk_new/SCLPDK_V3.0_KIT/scl180/stdcell/fs120/4M1IL/liberty/lib_flow_ff/tsl18fs120_scl_ff.lib } \
-P {1.0} -V {1.98} -T {-40}

create_library_set -name min_timing -timing {
/home/vedic_lab/sclpdk_new/SCLPDK_V3.0_KIT/scl180/stdcell/fs120/4M1IL/liberty/lib_flow_ff/tsl18fs120_scl_ff.lib /home/vedic_lab/sclpdk_new/SCLPDK_V3.0_KIT/scl180/iopad/cio150/4M1L/liberty/tsl18cio150_min.lib}

create_library_set -name max_timing -timing { 
